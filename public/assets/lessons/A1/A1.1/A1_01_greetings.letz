# A1.01/A1_01_greetings.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 1"

@lesson A1.01 "Greetings"

# --- Greetings ---
@word Moien = Hi
@word Gudde Moien = Good morning
@word Gudde Mëtteg = Good afternoon
@word Gudden Owend = Good evening
@word Gutt Nuecht = Good night
@word Bonjour = Hello
@word Salut = Hi
@word Wëllkomm = Welcome

# --- Farewells ---
@word Äddi = Bye
@word Awar = Bye
@word Ciao = Bye
@word Bis geschwënn = See you soon
@word Bis herno = See you later
@word Bis dann = See you later
@word Bis muer = See you tomorrow
@word Bis muer de Moien = See you tomorrow morning
@word Bis de Mëtteg = See you at noon
@word Bis den Owend = See you in the evening

# --- Politeness ---
@word Merci = Thank you
@word Pardon = Sorry
@word Entschëllegt = Excuse me
@word Wannechgelift = Please
@word Jo = Yes
@word Nee = No
@word Ganz gutt = Very good

# --- Feelings & states ---
@word traureg = sad
@word frou = happy
@word hongereg = hungry
@word kleng = small
@word sauer = sour
@word immens = really
@word alles = everything
@word vill = a lot
@word net = not

# --- Useful nouns ---
@word de Bic = the pen
@word de Kaffi = the coffee
@word d'Waasser = the water
@word d'Zäit = the time
@word d'Stad = the city
@word de Mupp = the dog
@word d'Muppen = the dogs
@word d'Plaz = the seat
@word de Stéck = the piece
@word d'Schockela = the chocolate
@word den Zocker = the sugar
@word d'Zitroun = the lemon
@word d'Zitrounen = the lemons
@word de Cappuccino = the cappuccino
@word d'Euro = the euro
@word dräi = three

# --- Verbs ---
@word sinn = to be
@word hunn = to have
@word ginn = to give
@word wunnen = to live
@word heeschen = to be called
@word kommen = to come
@word kënnen = can
@word wëllen = to want
@word drénken = to drink
@word duzen = to address informally
@word soen = to say
@word hëllefen = to help

