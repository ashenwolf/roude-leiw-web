@lesson A1.07 "Food & Shopping"

# --- Food & drink nouns (Quizlet cards 1-13) ---
@word en Iessen, d'Iessen (n), Iessen (pl) = food, meal, meals
@word Gedrénks = drinks
@word eng Wuerzel, d'Wuerzel (f), Wuerzelen (pl) = carrot, carrots
@word eng Zalot, d'Zalot (f), Zaloten (pl) = salad, salads
@word eng Gromper, d'Gromper (f), Gromperen (pl) = potato, potatoes
@word eng Tomat, d'Tomat (f), Tomaten (pl) = tomato, tomatoes
@word eng Courgette, d'Courgette (f), Courgetten = zucchini, zucchinis
@word eng Ënn, d'Ënn (f), Ënnen (pl) = onion, onions
@word en Apel, den Apel (m), Äppel (pl) = apple, apples
@word eng Banann, d'Banann (f), Banannen (pl) = banana, bananas
@word e Bréitchen, d'Bréitchen (n), Bréidercher (pl) = roll, rolls
@word e Kuch, de Kuch (m), Kuchen (pl) = cake, cakes
@word eng Taart, d'Taart (f), Taarten (pl) = pie, pies

# --- More nouns (Quizlet cards 21-30) ---
@word e Croissant, de Croissant (m), Croissanten (pl) = croissant, croissants
@word e Rezept, d'Rezept (n), Rezepter (pl) = recipe, recipes
@word eng Wurscht, d'Wurscht (f), Wurschten (pl) = sausage, sausages
@word en Déier, d'Déier (n), Déieren (pl) = animal, animals
@word en Handy, den Handy (m), Handyen (pl) = mobile phone, mobile phones
@word e Cours, de Cours (m), Coursen (pl) = class, classes
@word e Boot, d'Boot (n), Booter (pl) = boat, boats
@word e Fësch, de Fësch (m), Fësch (pl) = fish
@word e Béier, de Béier (m), Béier (pl) = beer, beers
@word e Glas, d'Glas (n), Glieser (pl) = glass, glasses (to drink out of)

# --- Containers & quantities (Quizlet cards 39-46) ---
@word eng Tut, d'Tut (f), Tuten (pl) = grocery bag, grocery bags
@word eng Béchs, d'Béchs (f), Béchsen (pl) = can, cans
@word en Dëppchen, d'Dëppchen (n), Dëppercher (pl) = container, containers
@word en Dëppche Jughurt = a container of yogurt
@word eng Béchs Kola = a can of cola
@word eng Dosen Eeër = a dozen eggs
@word e Pak Zocker = a pack of sugar
@word eng Tüb Zännseef = a tube of toothpaste

# --- Adverbs (Quizlet cards 62-63) ---
@word wéini = when
@word natierlech = of course

