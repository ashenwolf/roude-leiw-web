# A1.08/A1_08_places_and_directions.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 8"

@lesson A1.08 "Places & Directions"

# --- Buildings & places ---
@word d'Haus = the house
@word d'Haiser = the houses
@word d'Gebai = the building
@word d'Gebaier = the buildings
@word de Buttek = the shop
@word d'Butteker = the shops
@word d'Gemeng = the commune
@word d'Gemengen = the communes
@word den Theater = the theatre
@word d'Theateren = the theatres
@word d'Kierch = the church
@word d'Kierchen = the churches
@word d'Schoul = the school
@word d'Schoulen = the schools
@word d'Bréck = the bridge
@word d'Brécken = the bridges
@word de Kino = the cinema
@word d'Kinoen = the cinemas
@word d'Klinick = the hospital
@word d'Klinicken = the hospitals
@word d'Apdikt = the pharmacy
@word d'Apdikten = the pharmacies
@word de Café = the café
@word d'Caféen = the cafés
@word de Restaurant = the restaurant
@word d'Park = the park
@word d'Bank = the bank
@word d'Post = the post office
@word d'Stad = the city

# --- Prepositions of location ---
@word niewent = next to
@word an = in
@word op = at
@word tëschent = between
@word bei = close to
@word no bei = close to
@word wäit ewech vun = far away from
@word vis-à-vis vun = opposite
@word hannert = behind
@word virun = in front of

# --- Movement & direction ---
@word lénks = left
@word riets = right
@word riichtaus = straight ahead
@word laanscht = past
@word op der rietser Säit = on the right hand side
@word op der lénker Säit = on the left hand side
@word Richtung = in the direction of
@word Mamer = Mamer

# --- Floors ---
@word de Rez-de-chaussée = the ground floor
@word den éischte Stack = the first floor
@word de Stack = the floor
@word d'Stäck = the floors

# --- Other useful words ---
@word d'Wolleken = the clouds
@word de Kleederrayon = the clothing aisle
@word d'Bréckchen = the little bridge
@word de Beem = the trees

# --- Question words ---
@word Wuer = Where to

# --- Movement verbs ---
@word goen = to go
@word fueren = to drive
@word stoen = to stand

# --- Sentences ---

@sentence
@lu De Restaurant ass niewent der Kierch.
@en The restaurant is next to the church.
@distractor-en behind
@distractor-en school
@distractor-lu hannert
@distractor-lu Schoul

@sentence
@lu D'Emma ass an der Schoul.
@en Emma is in school.
@distractor-en church
@distractor-en home
@distractor-lu Kierch
@distractor-lu doheem

@sentence
@lu De Rick steet tëschent zwee Beem.
@en Rick is standing between two trees.
@distractor-en next to
@distractor-en three
@distractor-lu niewent
@distractor-lu dräi

@sentence
@lu De Park ass no bei der Bank.
@en The park is close to the bank.
@distractor-en post office
@distractor-en far
@distractor-lu Post
@distractor-lu wäit

@sentence
@lu D'Post ass wäit ewech vun der Bank.
@en The post office is far away from the bank.
@distractor-en close
@distractor-en church
@distractor-lu no bei
