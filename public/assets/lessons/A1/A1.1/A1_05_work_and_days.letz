# A1.05/A1_05_work_and_days.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 5"

@lesson A1.05 "Work & Days"

# --- Work-related verbs ---
@word schaffen = to work
@word schreiwen = to write
@word verteideg = to defend
@word liesen = to read
@word verkafen = to sell
@word këmmeren = to look after
@word geréieren = to manage
@word versuergen = to provide
@word schwätzen = to talk
@word maachen = to do
@word ausschaffen = to devise
@word hëllefen = to help
@word entwerfen = to design

# --- Workplace nouns ---
@word den Artikel = the article
@word d'Artikelen = the articles
@word d'Leit = the people
@word d'Recherche = the study
@word d'Recherchen = the studies
@word de Service = the service
@word d'Servicer = the services
@word d'Bankenindustrie = the banking industry
@word d'Personal = the personnel
@word de Fong = the fund
@word d'Fongen = the funds
@word den Enkel = the grandchild
@word d'Enkelen = the grandchildren
@word den Telefon = the telephone
@word d'Presentatioun = the presentation
@word d'Presentatiounen = the presentations
@word d'Strategie = the strategy
@word de Plang = the plan
@word d'Pläng = the plans
@word de Computer = the computer
@word de Coiffer = the hairdresser
@word d'Post = the post office
@word de Staat = the government
@word d'Bank = the bank
@word d'Banken = the banks
@word de Projet = the project
@word de Direkter = the director
@word de Ministère = the ministry
@word de Bus = the bus
@word de Gaart = the garden
@word d'Bicher = the books

# --- Days of the week ---
@word Méindeg = Monday
@word Dënschdeg = Tuesday
@word Mëttwoch = Wednesday
@word Donneschdeg = Thursday
@word Freideg = Friday
@word Samschdeg = Saturday
@word Sonndeg = Sunday

# --- Daily routine ---
@word opstoen = to get up
@word Zänn wäschen = to brush teeth
@word Sport maachen = to do sports
@word an d'Dusch goen = to go for a shower
@word d'Hoer kämmen = to brush hair
@word Kaffi drénken = to have breakfast
@word schaffe goen = to go to work
@word akafe goen = to go shopping
@word zu Mëtteg iessen = to have lunch
@word zu Nuecht iessen = to have dinner
@word schlofe goen = to go to sleep

