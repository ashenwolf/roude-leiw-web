# A1.02/A1_02_introductions_and_basics.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 2, Part A & Part B"

@lesson A1.02 "Introductions & Basics"

# === PART A: Introductions, Pronouns, Basic Nouns ===

# --- Question words ---
@word Wat = What
@word Wien = Who
@word Wou = Where
@word Wéi = How

# --- Personal pronouns ---
@word ech = I
@word du = you
@word hien = he
@word hatt = she
@word si = she
@word et = it
@word mir = we
@word dir = you
@word Dir = you
@word si = they

# --- Names & introductions ---
@word de Numm = the name
@word de Virnumm = the first name
@word d'Virnimm = the first names
@word den Nonumm = the last name
@word d'Nonimm = the last names
@word de Familljennumm = the surname
@word den Här = the gentleman
@word d'Madame = the lady
@word enchantéiert = pleased to meet you

# --- Useful words ---
@word schonn = already
@word esou vill = so much
@word nëmmen = only
@word dach = yes, of course
@word liicht = easy
@word riicht = straight
@word vun haut un = from today

# --- Nouns: things ---
@word d'Saach = the thing
@word d'Saachen = the things
@word d'Zil = the objective
@word d'Ziler = the objectives
@word den Dag = the day
@word d'Deeg = the days
@word d'Been = the leg
@word d'Fleesch = the meat
@word de Reen = the rain
@word d'Siicht = the view
@word den Eemer = the bucket
@word d'Eemeren = the buckets
@word d'Biischt = the broom
@word d'Biischten = the brooms
@word d'Kiischt = the cherry
@word d'Kiischten = the cherries
@word de Weess = the wheat
@word d'Rees = the journey
@word d'Reesen = the journeys
@word d'Leed = the suffering
@word d'Freed = the joy
@word d'Freeden = the joys
@word den Duuscht = the thirst

# --- Nouns: people ---
@word de Jong = the boy
@word d'Jongen = the boys
@word d'Meedchen = the girl
@word d'Meedercher = the girls
@word de Riichter = the judge
@word d'Riichteren = the judges

# --- Nouns: objects ---
@word de Fliger = the plane
@word d'Fligeren = the planes
@word de Kapp = the head
@word d'Käpp = the heads
@word d'Kap = the hat
@word d'Kapen = the hats

# --- Language & spelling ---
@word de Sproch = the expression
@word d'Spréch = the expressions
