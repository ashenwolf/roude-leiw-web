# A1/A1.1/A1_03_numbers_and_personal_info.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 3"
#   https://quizlet.com/_h2t12h
# All @word and @sentence content is taken verbatim from the Quizlet flashcards.
# Distractor tokens are sourced from other entries within this same Quizlet set.

@lesson A1.03 "Numbers & Personal Info"

# --- Numbers (Quizlet cards 1-11) ---
@word null = zero
@word eent = one
@word zwee = two
@word dräi = three
@word véier = four
@word fënnef = five
@word sechs = six
@word siwen = seven
@word aacht = eight
@word néng = nine
@word zéng = ten

# --- Phrase / vocabulary (Quizlet card 29) ---
@word zesummen = together

# --- Nouns with multiple forms (Quizlet cards 30-31) ---
@word e Brudder, de Brudder (m), Bridder (pl) = brother, brothers
@word eng Schwëster, d'Schwëster (f), Schwësteren (pl) = sister, sisters

# --- Sentences (Quizlet cards 12-28, 32-39) ---

@sentence
@lu Wéi ass deng Telefonsnummer?
@en What is your (informal) telephone number?
@distractor-en together
@distractor-en zero
@distractor-lu zesummen
@distractor-lu null

