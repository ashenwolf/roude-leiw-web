# A1/A1.1/A1_04_things_adjectives_and_weather.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 4"
#   https://quizlet.com/_h2swni
# Slash variants and bracket alternatives split into atomic pairs;
# gender markers (m)/(f)/(n)/(pl) stripped; multi-meaning EN like "wardrobe, wardrobes,
# cupboard, cupboards" expanded so each LU form pairs with each compatible EN.
# @fill added: weather frames (Et ass/Et gëtt), predicative adjectives with sinn/ass,
# question words, and prepositions (zu/beim/an/op).

@lesson A1.04 "Things, Adjectives & Weather"

# --- Household objects (Quizlet cards 2-7) ---
@word de Computer = computer
@word Computeren = computers

@word den Dësch = table
@word Dëscher = tables

@word d'Couche = sofa
@word Couchen = sofas

@word d'Luucht = lamp
@word Luuchten = lamps

@word d'Bett = bed
@word Better = beds

@word de Schaf = wardrobe
@word de Schaf = cupboard
@word Schief = wardrobes
@word Schief = cupboards

# --- Clothing (Quizlet cards 8-11) ---
@word d'Box = pants
@word Boxen = pants

@word de Pullover = jumper
@word Pulloveren = jumpers

@word den T-Shirt = t-shirt
@word T-Shirten = t-shirts

@word d'Hand = hand
@word Hänn = hands

# --- Rooms (Quizlet cards 12-16) ---
@word d'Buedzëmmer = bathroom
@word Buedzëmmeren = bathrooms

@word d'Schlofkummer = bedroom
@word Schlofkummeren = bedrooms

@word d'Toilette = toilet
@word d'Toilette = washroom
@word Toiletten = toilets
@word Toiletten = washrooms

@word d'Kichen = kitchen
@word Kichen = kitchens

@word d'Stuff = living room
@word Stuffen = living rooms

# --- Phrases / quantity words (Quizlet cards 24-31) ---
@word e Kaffi fir matzehuelen = a coffee to go
@word wéi vill = how much
@word wéi vill = how many
@word e bëssen = a bit
@word net vill = not much
@word net ze vill = not too much
@word méi = more
@word manner = less
@word genuch = enough

# --- Adjectives (Quizlet cards 32-42) ---
@word grouss = big
@word schéin = beautiful
@word al = old
@word nei = new
@word hell = bright
@word bëlleg = cheap
@word waarm = warm
@word kuerz = short
@word richteg = right
@word richteg = correct
@word lues = slow

# --- Colors (Quizlet cards 43-53) ---
@word wäiss = white
@word giel = yellow
@word gréng = green
@word blo = blue
@word rout = red
@word orange = orange
@word rosa = pink
@word mof = purple
@word gro = grey
@word brong = brown
@word schwaarz = black

# --- Vocabulary from sentences (coverage backfill) ---
@word d'Hoer = hair
@word de Wäin = wine
@word donkel = dark
@word frëndlech = friendly
@word blond = blond
@word sonneg = sunny
@word bedeckt = cloudy
@word niwweleg = foggy
@word reenen = to rain
@word schneien = to snow

# --- Sentences (Quizlet cards 1, 17-23, 54-69) ---

