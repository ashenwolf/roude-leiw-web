# A1.04/A1_04_things_adjectives_and_weather.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 4"

@lesson A1.04 "Things, Adjectives & Weather"

# --- Household objects ---
@word de Computer = the computer
@word d'Computeren = the computers
@word den Dësch = the table
@word d'Dëscher = the tables
@word d'Couche = the sofa
@word d'Couchen = the sofas
@word d'Luucht = the lamp
@word d'Luuchten = the lamps
@word d'Bett = the bed
@word d'Better = the beds
@word de Schaf = the wardrobe
@word d'Schief = the wardrobes

# --- Clothing ---
@word d'Box = the pants
@word d'Boxen = the pants plural
@word de Pullover = the jumper
@word d'Pulloveren = the jumpers
@word den T-Shirt = the t-shirt
@word d'T-Shirten = the t-shirts
@word d'Hand = the hand
@word d'Hänn = the hands

# --- Rooms ---
@word d'Buedzëmmer = the bathroom
@word d'Buedzëmmeren = the bathrooms
@word d'Schlofkummer = the bedroom
@word d'Schlofkummeren = the bedrooms
@word d'Toilette = the toilet
@word d'Toiletten = the toilets
@word d'Kichen = the kitchen
@word d'Stuff = the living room
@word d'Stuffen = the living rooms

# --- Drinks & food ---
@word de Glas Roude Wäin = the glass of red wine
@word de Kaffi fir matzehuelen = a coffee to go
@word alles = everything

# --- Quantity words ---
@word wéi vill = how much
@word e bëssen = a bit
@word net vill = not much
@word net ze vill = not too much
@word méi = more
@word manner = less
@word genuch = enough

# --- Adjectives ---
@word grouss = big
@word kleng = small
@word schéin = beautiful
@word al = old
@word nei = new
@word hell = bright
@word donkel = dark
@word bëlleg = cheap
@word waarm = warm
@word kuerz = short
@word richteg = right
@word liicht = light
@word lues = slow
@word frëndlech = friendly
@word blond = blonde

# --- Colors ---
@word wäiss = white
@word giel = yellow
@word gréng = green
@word blo = blue
@word rout = red
@word orange = orange
@word rosa = pink
@word mof = purple
@word gro = grey
@word brong = brown
@word schwaarz = black

# --- Hair & body ---
@word d'Hoer = the hair
@word d'Nuecht = the night
@word de Mann = the man

# --- Weather verbs ---
@word et schneit = it is snowing
@word et donnert = there is thunder
@word et blëtzt = there is lightning
@word et reent = it is raining
@word et stiermt = it is stormy
@word sonneg = sunny
@word bedeckt = cloudy
@word niwweleg = foggy

# --- Sentences ---

@sentence
@lu Wéi heescht dat op Lëtzebuergesch?
@en What is that called in Luxembourgish?
@distractor-en where
@distractor-en who
@distractor-lu Wou
@distractor-lu Wien

@sentence
@lu Wat ass dat?
@en What is that?
@distractor-en where
@distractor-en how
@distractor-lu Wou
@distractor-lu Wéi

