# A1/A1.1/A1_04_things_adjectives_and_weather.letz
# Source: Quizlet "A1 Basics Beginner Luxembourgish Lesson 4"
#   https://quizlet.com/_h2swni
# All @word and @sentence content is taken verbatim from the Quizlet flashcards.
# Distractor tokens are sourced from other entries within this same Quizlet set.

@lesson A1.04 "Things, Adjectives & Weather"

# --- Nouns with multiple forms (Quizlet cards 2-16) ---
@word e Computer, de Computer (m), Computeren (pl) = computer, computers
@word en Dësch, den Dësch (m), Dëscher (pl) = table, tables
@word eng Couche, d'Couche (f), Couchen (pl) = sofa, sofas
@word eng Luucht, d'Luucht (f), Luuchten (pl) = lamp, lamps
@word e Bett, d'Bett (n), Better (pl) = bed, beds
@word e Schaf, de Schaf (m), Schief (pl) = wardrobe, wardrobes, cupboard, cupboards
@word eng Box, d'Box (f), Boxen (pl) = pants
@word e Pullover, de Pullover (m), Pulloveren (pl) = jumper, jumpers
@word en T-Shirt, den T-Shirt (m), T-Shirten (pl) = t-shirt, t-shirts
@word eng Hand, d'Hand (f), Hänn (pl) = hand, hands
@word e Buedzëmmer, d'Buedzëmmer (n), Buedzëmmeren (pl) = bathroom, bathrooms
@word eng Schlofkummer, d'Schlofkummer (f), Schlofkummeren (pl) = bedroom, bedrooms
@word eng Toilette, d'Toilette (f), Toiletten (pl) = toilet, toilets, washroom, washrooms
@word eng Kichen, d'Kichen (f), Kichen (pl) = kitchen, kitchens
@word eng Stuff, d'Stuff (f), Stuffen (pl) = living room, living rooms

# --- Phrases / quantity words (Quizlet cards 24-31) ---
@word e Kaffi fir matzehuelen = a coffee to go
@word wéi vill = how much/how many
@word e bëssen = a bit
@word net vill = not much
@word net ze vill = not too much
@word méi = more
@word manner = less
@word genuch = enough

# --- Adjectives (Quizlet cards 32-42) ---
@word grouss = big
@word schéin = beautiful
@word al = old
@word nei = new
@word hell = bright
@word bëlleg = cheap
@word waarm = warm
@word kuerz = short
@word richteg = right (correct)
@word liicht = light
@word lues = slow

# --- Colors (Quizlet cards 43-53) ---
@word wäiss = white
@word giel = yellow
@word gréng = green
@word blo = blue
@word rout = red
@word orange = orange
@word rosa = pink
@word mof = purple
@word gro = grey
@word brong = brown
@word schwaarz = black

