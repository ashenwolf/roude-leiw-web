# A1/A1.2/A1_10_personal_details.letz
# Source: PDF slide deck "L1 .pdf" (A1 Conversation course, Lesson 1)
# (m)/(f)/(n) gender markers stripped; verb conjugation tables reduced to the infinitive;
# the alphabet letter-name chart and unanswered conjugation drills are skipped as
# pronunciation hints / exercises with no given answer.

@lesson A1.10 "Personal Details"

# --- Verbs ---
@word wunnen = to live
@word kommen = to come
@word virstellen = to introduce
@word buschtawéieren = to spell
@word iessen = to eat
@word bestueden = to get married
@word wëllen = to want
@word hunn = to have

# --- Time & manner ---
@word muer = tomorrow
@word spéit = late
@word ze spéit = too late
@word net méi = not anymore
@word direkt = immediately
@word ëmmer = always
@word zanter = since
@word zesummen = together
@word léiwer = rather

# --- Fixed phrases & greetings ---
@word ech heeschen = my name is
@word Mech och = Me too
@word Bis dann = See you then
@word Bis geschwënn = See you soon
@word Äddi = Goodbye
@word Merci = Thanks

# --- Small words ---
@word nee = no
@word net = not
@word och = too
@word oder = or
@word gutt = good
@word sech = himself
@word vill = many
@word al = old

# --- Nouns: time of day ---
@word de Moien = the morning
@word de Mëtteg = noon
@word den Owend = the evening
@word den Nomëtteg = the afternoon

# --- Nouns: alphabet & measure words ---
@word de Buschtaf = the letter
@word d'Joer = the year

# --- Numbers ---
@word eent = one
@word zwee = two
@word dräi = three
@word aacht = eight
@word zéng = ten
@word eelef = eleven
@word zwielef = twelve
@word fofzéng = fifteen
@word siechzéng = sixteen
@word uechtzéng = eighteen
