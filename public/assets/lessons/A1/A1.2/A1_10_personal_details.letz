@word zwanzeg = twenty
@word eenanzwanzeg = twenty-one
@word véierandrësseg = thirty-four
@word véierzeg = forty
@word sechsavéierzeg = forty-six
@word siwenafofzeg = fifty-seven
@word eenasiechzeg = sixty-one
@word néngasiwwenzeg = seventy-nine
@word achtzeg = eighty
@word néngannonzeg = ninety-nine
@word honnert = one hundred
@word honnerteent = one hundred and one

# --- Civil status ---
@word bestuet = married
@word gescheet = divorced
@word getrennt = separated
@word verloobt = engaged
@word de Jonggesell = the bachelor
@word d'Jonggesellin = the bachelorette

# --- Places & origin ---
@word Frankräich = France
@word Paräis = Paris
@word d'Belsch = Belgium
@word Bréissel = Brussels
@word d'Ukrain = Ukraine
@word Lëtzebuerg = Luxembourg
@word d'Stad = the city

