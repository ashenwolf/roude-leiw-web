@word eenasiechzeg = sixty-one
@word néngasiwwenzeg = seventy-nine
@word achtzeg = eighty
@word néngannonzeg = ninety-nine
@word honnert = one hundred
@word honnerteent = one hundred and one

# --- Civil status ---
@word bestuet = married
@word gescheet = divorced
@word getrennt = separated
@word verloobt = engaged
@word de Jonggesell = the bachelor
@word d'Jonggesellin = the bachelorette

