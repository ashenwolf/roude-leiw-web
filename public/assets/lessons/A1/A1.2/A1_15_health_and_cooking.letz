@word d'Uebstzalot = fruit salad
@word griichesch = Greek
@word d'Bouneschlupp = bean soup
@word d'Mettwurscht = sausage
@word d'Britt = stock

# --- Illness ---
@word erkaalt sinn = to have a cold
@word de Schnapp hunn = to have a runny nose
@word den Houscht = cough
@word houschten = to cough
@word d'Féiwer = fever
@word d'Gripp = flu
@word eng Erkältung = a cold
@word de Krankeschäin = sick note
@word den Thermometer = thermometer
@word de Grad = degree
@word weisen = to show

# --- Body parts ---
@word d'Käpp = heads
@word d'Nuesen = noses
@word de Bauch = stomach
@word d'Bäich = stomachs
@word d'Hänn = hands
@word den Hals = throat
@word de Réck = back
@word d'Récker = backs
@word den Aarm = arm
@word d'Äerm = arms
@word de Knéi = knee
@word d'Knéien = knees
@word de Fouss = foot
@word d'Féiss = feet
@word d'Ouer = ear
@word d'Oueren = ears
@word d'Zant = tooth
@word d'Zänn = teeth

# --- Medicine ---
@word d'Rezepter = prescriptions
@word de Sirop = cough syrup
@word d'Siroppen = cough syrups
@word d'Pastill = lozenge
@word d'Pastillen = lozenges
@word d'Medikament = medication
@word d'Medikamenter = medications

# --- Verbs ---
@word mengen = to think
@word bleiwen = to stay
@word brauchen = to need
@word verdonsten = to evaporate
@word benotzen = to use
@word ophalen = to stop

# --- Other vocabulary ---
@word d'Boma = grandma
@word de Wäisswäin = white wine
@word de Schockela = chocolate
@word de Fussball = football
@word d'Musek = music
@word den Computer = computer
@word d'Aarbecht = work
@word haart = loud

# --- Pain compounds (Part 2 grammar: "eppes wéi hunn" pattern) ---
@word de Kappwéi = the headache
@word den Halswéi = the sore throat
@word de Bauchwéi = the stomach ache
@word de Réckwéi = the backache
@word d'Zännwéi = the toothache

# --- Ordinal adverbs (Part 2 grammar) ---
@word fir d'zweet = second, secondly
@word fir d'drëtt = third, thirdly

# --- Fixed phrases ---
@word net gutt = not good
@word Villmools Merci = thank you very much
@word Äddi an eng gutt Besserung = Goodbye and get well soon

