# A1/A1.2/A1_18_home_and_rooms.letz
# Source: PDF slide deck "L9 a1convlotsmanmeli.pdf" (A1 Conversation course, Lesson 9)
# (m)/(f)/(n)/(pl) markers stripped; kept only the article. Synonym pairs in the
# deck (Schlofkummer/Schlofzëmmer, d'Couche/de Canapé, Këssen/Pillem,
# däischter/donkel) are taught once, using the form that appears in a sentence.
# Fills added: 18 — locative prepositions with rooms/furniture (10), negation
# kee/keng for rooms (4), separable verbs opmaachen/zoumaachen (4). Mined from
# the deck's "Mäin Haus" fill-in exercise (p13/p16) and picture-labelled rooms.

@lesson A1.18 "Home & Rooms"

# --- Dwelling types, floors & area ---
@word d'Wunneng = the home
@word d'Wunnengen = the homes

@word d'Appartement = the flat
@word d'Appartementer = the flats

@word d'Duerf = the village
@word d'Géigend = the neighbourhood

# --- Rooms ---
@word de Gank = the hallway
@word d'Iesszëmmer = the dining room

@word d'Schlofzëmmer = the bedroom
@word d'Schlofzëmmeren = the bedrooms
@word d'Eltereschlofzëmmer = the parents' bedroom
@word d'Kannerschlofzëmmer = the children's bedroom

@word d'Buedbidden = the bathtub

@word de Living = the living room

@word de Späicher = the attic
@word de Keller = the cellar

@word d'Zëmmer = the room
@word d'Zëmmeren = the rooms

@word d'Toiletten = the toilets

@word de Balcon = the balcony
@word d'Balconen = the balconies

@word d'Garage = the garage
@word d'Garagen = the garages

@word d'Terrass = the terrace
@word d'Terrassen = the terraces

@word d'Piscine = the swimming pool
@word d'Piscinnen = the swimming pools

@word d'Fënsteren = the windows

# --- Furniture & household objects ---
@word de Frigo = the fridge
@word d'Frigoen = the fridges

@word d'Fotell = the armchair
@word d'Fotellen = the armchairs

@word d'Dusch = the shower

@word d'Better = the beds

@word d'Schief = the wardrobes

@word d'Steeluucht = the floor lamp

@word den Iessdësch = the dining table

@word de Spigel = the mirror
@word d'Spigelen = the mirrors

@word de Canapé = the couch

@word d'Kommoud = the chest of drawers
@word d'Kommouden = the chests of drawers

@word d'Wäschmaschinn = the washing machine

@word den Teppech = the carpet
@word d'Teppecher = the carpets

@word d'Spullmaschinn = the dishwasher

@word d'Këssen = the pillow

@word de Kaffisdësch = the breakfast table
@word de Salonsdësch = the coffee table
@word de Bicherschaf = the bookcase

@word d'Kaerz = the candle
@word d'Käerzen = the candles

@word de Buedem = the floor
@word d'Buedduch = the bath towel

@word de Besuch = the visit

# --- Adjectives: size, condition, style, colour ---
@word däischter = dark
@word modern = modern
@word almoudesch = old-fashioned
@word roueg = quiet
@word oppen = open
@word ellen = ugly
@word hëlzen = wooden
@word metallen = metallic
@word gemittlech = cozy
@word propper = clean
@word knaschteg = dirty
@word eegen = own
@word breet = wide
@word beige = beige
@word amerikanesch = American
@word separat = separate

# --- Verbs ---
@word zoumaachen = to close
@word opmaachen = to open
@word bueden = to bathe
@word stockéieren = to store
@word gefalen = to please

# --- Numbers, directions & question words ---
@word do = there
@word wiem = whom
@word wuer = where (direction)

