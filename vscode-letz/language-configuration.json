{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["\"", "\""]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["\"", "\""]
  ],
  "wordPattern": "[\\w\\p{L}]+",
  "folding": {
    "markers": {
      "start": "^@lesson",
      "end": "^(?=@lesson)"
    }
  }
}
